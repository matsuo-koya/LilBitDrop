@@ -310,6 +315,22 @@ fn handle_tls_connection(
             }
         }
         served += 1;
+        if ended_at_trailer {
+            // The sender may still send the last-chunk after our response.
+            // Read it (briefly) before closing so unread bytes don't turn our
+            // close into a RST that discards the response in flight.
+            let _ = reader.get_ref().sock.set_read_timeout(Some(std::time::Duration::from_secs(2)));
+            let mut sink = [0u8; 4096];
+            for _ in 0..4 {
