+/// Incremental end-of-archive detector for a dvzip `/Upload` body that is
+/// still arriving.
+///
+/// AirBridge (iOS 27.2, 2026-10-08): for a ~5.6 MB photo the sender streamed
+/// the whole dvzip (ending in the block that carries the cpio `TRAILER!!!`)
+/// but never sent the chunked last-chunk `0\r\n\r\n`; it waited for our
+/// response while we waited for the terminator, and iOS reported the
+/// transfer as declined. The archive end tells us the body is complete.
+#[derive(Debug, Default)]
+pub struct DvzipEndDetector {
+    scan_pos: usize,
+}
+
+impl DvzipEndDetector {
+    /// `body` is the decoded (de-chunked) body received so far. Each complete
+    /// block is inspected once. Returns true when the blocks end exactly at
+    /// `body.len()` and the last one holds the cpio trailer entry.
+    pub fn complete(&mut self, body: &[u8]) -> bool {
+        let mut trailer = false;
+        while self.scan_pos + 4 <= body.len() {
+            let word = u32::from_be_bytes([
+                body[self.scan_pos],
+                body[self.scan_pos + 1],
+                body[self.scan_pos + 2],
+                body[self.scan_pos + 3],
+            ]);
+            let len = (word & !STORED_BLOCK_FLAG) as usize;
+            let start = self.scan_pos + 4;
+            if len == 0 || start + len > body.len() {
+                return false; // block not fully received yet
+            }
+            let block = &body[start..start + len];
+            trailer = if word & STORED_BLOCK_FLAG != 0 {
+                contains_cpio_trailer(block)
+            } else {
+                let mut out = Vec::new();
+                ZlibDecoder::new(block).read_to_end(&mut out).is_ok() && contains_cpio_trailer(&out)
+            };
+            self.scan_pos = start + len;
+        }
+        trailer && self.scan_pos == body.len()
+    }
+}
+
+fn contains_cpio_trailer(data: &[u8]) -> bool {
+    const TRAILER: &[u8] = b"TRAILER!!!\0";
+    data.windows(TRAILER.len()).any(|w| w == TRAILER)
+}
+
 /// Encode a CPIO archive as a dvzip payload: zlib-compress the whole archive
 /// and frame it as a single `[u32 BE length][zlib stream]` block. The decoder
 /// ([`dvzip_to_cpio`) handles any number of blocks; one block is functionally
@@ -121,7 +170,7 @@ pub fn cpio_to_dvzip_blocks(cpio: &[u8], num_blocks: usize) -> Vec<u8> {
 
 #[cfg(test)]
 mod tests {
-    use super::{cpio_to_dvzip, cpio_to_dvzip_blocks, dvzip_to_cpio, STORED_BLOCK_FLAG};
+    use super::{cpio_to_dvzip, cpio_to_dvzip_blocks, dvzip_to_cpio, DvzipEndDetector, STORED_BLOCK_FLAG};
     use crate::cpio::build_odc_cpio;
     use flate2::write::ZlibEncoder;
     use flate2::Compression;
@@ -249,4 +298,20 @@ mod tests {
         body.extend_from_slice(&cpio_to_dvzip(c));
         assert_eq!(dvzip_to_cpio(&body), cpio);
     }
+
+    #[test]
+    fn end_detector_fires_only_after_trailer_block_completes() {
+        let cpio = build_odc_cpio(&[("photo.jpg", &[0xCD; 5000])]);
+        let body = cpio_to_dvzip_blocks(&cpio, 3);
+        let mut det = DvzipEndDetector::default();
+        // Feed in uneven pieces, like HTTP chunks.
+        let mut fired_at = None;
+        for end in (1..=body.len()).step_by(777).chain([body.len()]) {
+            if det.complete(&body[..end]) {
+                fired_at = Some(end);
+                break;
+            }
+        }
+        assert_eq!(fired_at, Some(body.len()));
+    }
 }
