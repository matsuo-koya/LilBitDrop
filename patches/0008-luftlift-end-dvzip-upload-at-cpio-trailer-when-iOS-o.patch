-fn read_body(reader: &mut impl BufRead, header_bytes: &[u8]) -> Result<Vec<u8>> {
+/// Returns the body and whether a chunked dvzip body was ended at its cpio
+/// trailer because the sender never sent the last-chunk (see
+/// [`crate::dvzip::DvzipEndDetector`]).
+fn read_body(reader: &mut impl BufRead, header_bytes: &[u8]) -> Result<(Vec<u8>, bool)> {
     let head_str = std::str::from_utf8(header_bytes).unwrap_or("");
     if let Some(cl_str) = parse_header_value(head_str, "content-length") {
         let len: usize = cl_str.parse().unwrap_or(0);
         let mut body = vec![0u8; len];
         reader.read_exact(&mut body)?;
-        Ok(body)
+        Ok((body, false))
     } else if let Some(te_str) = parse_header_value(head_str, "transfer-encoding") {
         if te_str.to_ascii_lowercase().contains("chunked") {
-            Ok(read_chunked_stream(reader)?)
+            let dvzip = parse_header_value(head_str, "content-type")
+                .is_some_and(|ct| ct.eq_ignore_ascii_case("application/x-dvzip"));
+            read_chunked_stream(reader, dvzip)
         } else {
-            Ok(Vec::new())
+            Ok((Vec::new(), false))
         }
     } else {
-        Ok(Vec::new())
+        Ok((Vec::new(), false))
     }
 }
 
@@ -239,7 +244,7 @@ fn handle_tls_connection(
                 reader.get_mut().flush()?;
             }
