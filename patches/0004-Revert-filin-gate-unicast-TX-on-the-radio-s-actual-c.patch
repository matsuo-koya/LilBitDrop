Subject: [PATCH 4/8] Revert "filin: gate unicast TX on the radio's actual
 channel, not own sequence slot"

This reverts commit e7a8229caf3a43a7987101fd294d284a503541f3.
---
 crates/filin-rs/src/lib.rs | 30 ++----------------------------
 1 file changed, 2 insertions(+), 28 deletions(-)

diff --git a/crates/filin-rs/src/lib.rs b/crates/filin-rs/src/lib.rs
index bc60405..555ec8e 100644
--- a/crates/filin-rs/src/lib.rs
+++ b/crates/filin-rs/src/lib.rs
@@ -1910,7 +1910,7 @@ pub mod schedule {
     pub fn data_send_decision(
         dst: &[u8; 6],
         current_channel: u8,
-        _own_seq: &[[u8; 2]; CHANSEQ_LEN],
+        own_seq: &[[u8; 2]; CHANSEQ_LEN],
         peers: &crate::peers::PeerTable,
         sync: &SyncState,
         now_us: u64,
@@ -1935,14 +1935,7 @@ pub mod schedule {
                 // hold — a held non-peer frame would block the TAP forever.
                 return DataSendDecision::Drop;
             };
-            // AirBridge: compare the peer's scheduled channel with the channel
-            // the radio is ACTUALLY on, not our own sequence slot. They differ
-            // while the transfer pin holds the radio on the peer's channel
-            // (and when a switch fails, e.g. ch149 is disabled in JP); gating
-            // on the sequence held our TCP ACKs ~0.4 s per burst during an
-            // upload, so the iPhone crawled at ~150 KB/s and gave up.
-            let slot = usize::from(sync.current_eaw(now_us) % CHANSEQ_LEN as u16);
-            if slot_channel(&peer.sequence, slot) != current_channel {
+            if !same_channel_as_peer(own_seq, &peer.sequence, sync, now_us) {
                 return DataSendDecision::Hold; // peer is on a different channel
             }
             if can_send_in(sync, now_us, UNICAST_GUARD_TU) != 0 {
@@ -2580,25 +2573,6 @@ pub mod schedule {
             );
         }
 
-        #[test]
-        fn unicast_follows_actual_radio_channel_not_own_sequence() {
-            // Transfer pin: the radio is held on the iPhone's channel 44 while
-            // the adopted master sequence says 48. TCP ACKs must go out.
-            let sync = synced();
-            let phone = [0x92, 0xa5, 0xbd, 0x14, 0x74, 0x71];
-            let peers = peer_on_channel(phone, 44);
-            let own_seq = [[48u8, 0x80u8]; CHANSEQ_LEN];
-            assert_eq!(
-                data_send_decision(&phone, 44, &own_seq, &peers, &sync, 1_032_768),
-                DataSendDecision::Send,
-            );
-            // Radio really on 48 while the peer is on 44: hold.
-            assert_eq!(
-                data_send_decision(&phone, 48, &own_seq, &peers, &sync, 1_032_768),
-                DataSendDecision::Hold,
-            );
-        }
-
         #[test]
         fn broadcast_dst_is_not_peer_gated() {
             // ff:ff:ff:ff:ff:ff also has the I/G bit set and must not be
