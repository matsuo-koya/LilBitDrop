+
+    #[test]
+    fn service_responses_match_macos_capture_byte_for_byte() {
+        // Mac mini M4 (macOS) AirDrop receiver, captured 2026-10-08.
+        let svc = AirdropService { instance: "7a6db550c271".into(), port: 8770, txt: vec![] };
+        let v = build_service_response_values(&svc, "3433d50b-c7f6-48f6-b8e4-b52fa2125ac3");
+        assert_eq!(v[0], hex("0300c0070c0f0000000c376136646235353063323731c000"));
+        assert_eq!(
+            v[1],
+            hex("10000c376136646235353063323731c007212d0000000000000022422433343333643530622d633766362d343866362d623865342d623532666132313235616333c00c")
+        );
+        assert_eq!(v[2], hex("10000c376136646235353063323731c007100100000000"));
+    }
+
+    #[test]
+    fn service_parameters_bloom_matches_macos_bytes_19_and_22() {
+        // Mac mini short form: offsets 0x11480000 → bytes 19,22,24,28 = 40 80 04 04.
+        let v = build_service_parameters_value(0x86e3, true);
+        assert_eq!(v, hex("000000e38600004800" ).into_iter().chain([0x40, 0x80]).collect::<Vec<_>>());
+        assert_eq!(build_service_parameters_value(7, false), hex("000000070000000000"));
+    }
+
+    fn mdns_frame(ptr_ttl: u32) -> Vec<u8> {
+        // Ethernet + IPv6 + UDP header, then a DNS response with a compressed
+        // PTR/SRV/TXT set like mdns-sd emits.
+        let mut dns = vec![0, 0, 0x84, 0, 0, 0, 0, 3, 0, 0, 0, 0];
+        let svc_at = dns.len();
+        dns.extend_from_slice(b"\x08_airdrop\x04_tcp\x05local\x00");
+        dns.extend_from_slice(&[0, 12, 0, 1]);
+        dns.extend_from_slice(&ptr_ttl.to_be_bytes());
+        let inst = b"\x0eluftlift-18387";
+        dns.extend_from_slice(&((inst.len() + 2) as u16).to_be_bytes());
+        let inst_at = dns.len();
+        dns.extend_from_slice(inst);
+        dns.extend_from_slice(&[0xc0, svc_at as u8]);
+        // SRV, owner compressed to the instance name
+        dns.extend_from_slice(&[0xc0, inst_at as u8, 0, 33, 0x80, 1, 0, 0, 0, 120]);
+        let target = b"\x04pi4B\x05local\x00";
+        dns.extend_from_slice(&((6 + target.len()) as u16).to_be_bytes());
+        dns.extend_from_slice(&[0, 0, 0, 0, 0x22, 0x43]);
+        dns.extend_from_slice(target);
+        // TXT
+        dns.extend_from_slice(&[0xc0, inst_at as u8, 0, 16, 0x80, 1, 0, 0, 0x11, 0x94]);
+        dns.extend_from_slice(&10u16.to_be_bytes());
+        dns.extend_from_slice(b"\x09flags=136");
+        let mut f = vec![0x33, 0x33, 0, 0, 0, 0xfb, 0, 0x3a, 0x9d, 0xaa, 0xac, 0xf8, 0x86, 0xdd];
+        let mut ip = vec![0x60, 0, 0, 0];
+        ip.extend_from_slice(&((8 + dns.len()) as u16).to_be_bytes());
+        ip.extend_from_slice(&[17, 255]);
+        ip.extend_from_slice(&[0; 32]);
+        f.extend(ip);
+        f.extend_from_slice(&[0x14, 0xe9, 0x14, 0xe9]);
+        f.extend_from_slice(&((8 + dns.len()) as u16).to_be_bytes());
+        f.extend_from_slice(&[0, 0]);
+        f.extend(dns);
+        f
+    }
+
+    #[test]
+    fn parses_live_announce_and_goodbye() {
+        assert_eq!(
+            parse_airdrop_announce(&mdns_frame(4500)),
+            Some(Announce::Service(AirdropService {
+                instance: "luftlift-18387".into(),
+                port: 8771,
+                txt: vec![b"flags=136".to_vec()],
+            }))
+        );
+        assert_eq!(parse_airdrop_announce(&mdns_frame(0)), Some(Announce::Goodbye));
+    }
+
+    #[test]
+    fn ignores_non_mdns_and_queries() {
+        let mut f = mdns_frame(4500);
+        f[14 + 40 + 8 + 2] = 0; // clear QR: now a query
+        assert_eq!(parse_airdrop_announce(&f), None);
+        assert_eq!(parse_airdrop_announce(&f[..20]), None);
+    }
+}
