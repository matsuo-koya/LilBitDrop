+//! AWDL service-discovery offload for the AirDrop receiver (AirBridge).
+//!
+//! Apple devices fold Bonjour PTR/SRV/TXT records into their MIFs as
+//! **Service Response TLVs (type 2)** and advertise which services they carry
+//! in the **Service Parameters TLV (type 6)** bloom. Observed 2026-10-08: an
+//! iOS 27.2 sender with the AirDrop sheet open sends *no* mDNS on awdl0 at
+//! all, while every nearby macOS AirDrop receiver advertises `_airdrop._tcp`
+//! this way. filin used to send only an empty Service Parameters TLV, so the
+//! iPhone found us only when a multicast mDNS announce happened to land in its
+//! listen window (minutes, or never).
+//!
+//! This module turns our own mDNS announce (read from the awdl0 TAP, as sent
+//! by luftlift) into the equivalent TLVs, so luftlift stays the single source
+//! of truth for the instance name, port and TXT.
+//!
+//! TLV value layout (decoded with Wireshark's AWDL dissector and matched
+//! byte-for-byte against a Mac mini M4 capture, see tests):
+//!
+//! ```text
+//! u16 LE  name_len   encoded name length + 1 (the type byte)
+//! name               DNS labels ending in a 2-byte AWDL compression code
+//! u8      type       12 PTR / 33 SRV / 16 TXT
+//! u16 LE  data_len   rdata length
+//! u16     0          unknown, always 0
+//! rdata              PTR: labels + 0xc000; SRV: prio, weight, port (BE),
+//!                    target labels + 0xc00c; TXT: length-prefixed strings
+//! ```
+
+/// Service Response TLV type.
+pub const SERVICE_RESPONSE_TLV: u8 = 2;
+
+const RR_PTR: u8 = 12;
+const RR_TXT: u8 = 16;
+const RR_SRV: u8 = 33;
+
+/// AWDL DNS compression codes (Wireshark `packet-awdl.c` table).
+const AWDL_NULL: u16 = 0xc000;
+const AWDL_AIRDROP_TCP_LOCAL: u16 = 0xc007;
+const AWDL_LOCAL: u16 = 0xc00c;
+
+/// Bits of the 256-bit Service Parameters bloom set by every macOS AirDrop
+/// receiver observed (iMac M1 and Mac mini M4, ≥95% of 923 frames) and absent
+/// from a browsing-only iPhone. Both are set: they cover `_airdrop._tcp`
+/// (possibly together with `_airplay-p2p._tcp`, the only other service both
+/// Macs always carried), and a false positive only makes a peer look at our
+/// Service Responses.
+pub const AIRDROP_BLOOM_BITS: [u8; 2] = [158, 183];
+
+/// What our own mDNS packet says about the `_airdrop._tcp` service.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Announce {
+    /// A live announce (PTR TTL > 0) with its SRV.
+    Service(AirdropService),
+    /// A goodbye (PTR TTL == 0): the receiver is going away.
+    Goodbye,
+}
+
+/// The `_airdrop._tcp` instance luftlift is advertising.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AirdropService {
+    /// Instance label, e.g. `luftlift-18387`.
+    pub instance: String,
+    /// HTTPS port from the SRV record.
+    pub port: u16,
+    /// TXT strings (without length prefixes), e.g. `flags=136`.
+    pub txt: Vec<Vec<u8>>,
+}
+
+/// Parse an Ethernet frame from the TAP. Returns `None` unless it is an
+/// IPv6/UDP mDNS response that carries a `_airdrop._tcp.local` PTR.
+pub fn parse_airdrop_announce(frame: &[u8]) -> Option<Announce> {
+    if frame.len() < 14 + 40 + 8 + 12 || u16::from_be_bytes([frame[12], frame[13]]) != 0x86dd {
+        return None;
+    }
+    if frame[14 + 6] != 17 {
+        return None; // not UDP
+    }
+    let udp = &frame[14 + 40..];
+    if u16::from_be_bytes([udp[0], udp[1]]) != 5353 {
+        return None;
+    }
+    parse_dns(&udp[8..])
+}
+
+fn parse_dns(msg: &[u8]) -> Option<Announce> {
+    let rd16 = |p: usize| -> Option<u16> { Some(u16::from_be_bytes([*msg.get(p)?, *msg.get(p + 1)?])) };
+    if rd16(2)? & 0x8000 == 0 {
+        return None; // a query, not a response
+    }
+    let qd = rd16(4)? as usize;
+    let rr = rd16(6)? as usize + rd16(8)? as usize + rd16(10)? as usize;
+    let mut pos = 12;
+    for _ in 0..qd {
+        pos = read_name(msg, pos)?.1 + 4;
+    }
+    let mut instance: Option<(Vec<u8>, String, u32)> = None; // (label, full name, ttl)
+    let mut srvs: Vec<(String, u16)> = Vec::new();
+    let mut txts: Vec<(String, Vec<Vec<u8>>)> = Vec::new();
+    for _ in 0..rr {
+        let (owner, p) = read_name(msg, pos)?;
+        let rtype = rd16(p)?;
+        let ttl = u32::from_be_bytes(msg.get(p + 4..p + 8)?.try_into().ok()?);
+        let rdlen = rd16(p + 8)? as usize;
+        let rdata_at = p + 10;
+        let rdata = msg.get(rdata_at..rdata_at + rdlen)?;
+        pos = rdata_at + rdlen;
+        let owner_s = join(&owner);
+        match rtype {
+            t if t == u16::from(RR_PTR) && owner_s == "_airdrop._tcp.local" => {
+                let (target, _) = read_name(msg, rdata_at)?;
+                let label = target.first()?.clone();
+                instance = Some((label, join(&target), ttl));
+            }
+            t if t == u16::from(RR_SRV) && rdata.len() >= 6 => {
+                srvs.push((owner_s, u16::from_be_bytes([rdata[4], rdata[5]])));
+            }
+            t if t == u16::from(RR_TXT) => {
+                let mut strings = Vec::new();
+                let mut i = 0;
+                while i < rdata.len() {
+                    let n = rdata[i] as usize;
+                    let s = rdata.get(i + 1..i + 1 + n)?;
+                    if !s.is_empty() {
+                        strings.push(s.to_vec());
+                    }
+                    i += 1 + n;
+                }
+                txts.push((owner_s, strings));
+            }
+            _ => {}
+        }
+    }
+    let (label, full, ttl) = instance?;
+    if ttl == 0 {
+        return Some(Announce::Goodbye);
+    }
+    let port = srvs.iter().find(|(o, _)| *o == full).map(|(_, p)| *p)?;
+    let txt = txts.into_iter().find(|(o, _)| *o == full).map(|(_, t)| t).unwrap_or_default();
+    Some(Announce::Service(AirdropService {
+        instance: String::from_utf8_lossy(&label).into_owned(),
+        port,
+        txt,
+    }))
+}
+
+/// Read a (possibly compressed) DNS name at `pos`. Returns the labels and the
+/// position just after the name in the original stream.
+fn read_name(msg: &[u8], mut pos: usize) -> Option<(Vec<Vec<u8>>, usize)> {
+    let mut labels = Vec::new();
+    let mut end = None;
+    for _ in 0..64 {
+        let len = *msg.get(pos)? as usize;
+        if len == 0 {
+            return Some((labels, end.unwrap_or(pos + 1)));
+        }
+        if len & 0xc0 == 0xc0 {
+            let target = ((len & 0x3f) << 8) | *msg.get(pos + 1)? as usize;
+            end.get_or_insert(pos + 2);
+            pos = target;
+            continue;
+        }
+        labels.push(msg.get(pos + 1..pos + 1 + len)?.to_vec());
+        pos += 1 + len;
+    }
+    None // pointer loop
+}
+
+fn join(labels: &[Vec<u8>]) -> String {
+    labels
+        .iter()
+        .map(|l| String::from_utf8_lossy(l).to_ascii_lowercase())
+        .collect::<Vec<_>>()
+        .join(".")
+}
+
+fn push_label(out: &mut Vec<u8>, label: &[u8]) {
+    let label = &label[..label.len().min(63)];
+    out.push(label.len() as u8);
+    out.extend_from_slice(label);
+}
+
+fn record(name: &[u8], rtype: u8, rdata: &[u8]) -> Vec<u8> {
+    let mut v = Vec::with_capacity(7 + name.len() + rdata.len());
+    v.extend_from_slice(&((name.len() + 1) as u16).to_le_bytes());
+    v.extend_from_slice(name);
+    v.push(rtype);
+    v.extend_from_slice(&(rdata.len() as u16).to_le_bytes());
+    v.extend_from_slice(&[0, 0]);
+    v.extend_from_slice(rdata);
+    v
+}
+
+/// Build the PTR, SRV and TXT Service Response TLV values for `svc`, with the
+/// SRV target `<host>.local` (`host` must match our Arpa TLV hostname).
+pub fn build_service_response_values(svc: &AirdropService, host: &str) -> Vec<Vec<u8>> {
+    let mut instance_name = Vec::new();
+    push_label(&mut instance_name, svc.instance.as_bytes());
+    instance_name.extend_from_slice(&AWDL_AIRDROP_TCP_LOCAL.to_be_bytes());
+
+    let mut ptr_rdata = Vec::new();
+    push_label(&mut ptr_rdata, svc.instance.as_bytes());
+    ptr_rdata.extend_from_slice(&AWDL_NULL.to_be_bytes());
+
+    let mut srv_rdata = vec![0, 0, 0, 0];
+    srv_rdata.extend_from_slice(&svc.port.to_be_bytes());
+    push_label(&mut srv_rdata, host.as_bytes());
+    srv_rdata.extend_from_slice(&AWDL_LOCAL.to_be_bytes());
+
+    let mut txt_rdata = Vec::new();
+    for s in &svc.txt {
+        push_label(&mut txt_rdata, s);
+    }
+    if txt_rdata.is_empty() {
+        txt_rdata.push(0); // empty TXT = one zero-length string (as macOS sends)
+    }
+
+    vec![
+        record(&AWDL_AIRDROP_TCP_LOCAL.to_be_bytes(), RR_PTR, &ptr_rdata),
+        record(&instance_name, RR_SRV, &srv_rdata),
+        record(&instance_name, RR_TXT, &txt_rdata),
+    ]
+}
+
+/// Service Parameters TLV value: 3 zero bytes, SUI (u16 LE), then the bloom as
+/// a u32 LE bitmap of non-zero byte offsets followed by those bytes.
+/// Without services this is the 9 zero bytes filin always sent.
+pub fn build_service_parameters_value(sui: u16, airdrop: bool) -> Vec<u8> {
+    let mut v = vec![0, 0, 0];
+    v.extend_from_slice(&sui.to_le_bytes());
+    if !airdrop {
+        v.extend_from_slice(&0u32.to_le_bytes());
+        return v;
+    }
+    let mut bloom = [0u8; 32];
+    for bit in AIRDROP_BLOOM_BITS {
+        bloom[usize::from(bit / 8)] |= 1 << (bit % 8);
+    }
+    let offsets = bloom
+        .iter()
+        .enumerate()
+        .filter(|(_, b)| **b != 0)
+        .fold(0u32, |acc, (i, _)| acc | 1 << i);
+    v.extend_from_slice(&offsets.to_le_bytes());
+    v.extend(bloom.iter().copied().filter(|b| *b != 0));
+    v
+}
+
