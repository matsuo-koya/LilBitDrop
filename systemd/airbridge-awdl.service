[Unit]
Description=AirBridge AWDL link (filin)
# Not After=multi-user.target: the receiver is WantedBy multi-user and ordered
# after this unit, so that would form an ordering cycle and systemd drops the
# receiver job at boot.
After=network.target NetworkManager.service

[Service]
Type=simple
EnvironmentFile=/etc/airbridge.conf
ExecStart=/opt/airbridge/bin/filin -i ${WIFI_IFACE} -c ${AWDL_CHANNEL} -h ${AWDL_IFACE}
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
