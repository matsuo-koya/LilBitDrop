[Unit]
Description=AirBridge USB network (RNDIS gadget + DHCP for the host PC)
After=network-pre.target NetworkManager.service
Wants=network-pre.target

[Service]
Type=simple
ExecStartPre=/opt/airbridge/bin/usb-gadget.sh
ExecStart=/opt/airbridge/bin/usb-network.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
